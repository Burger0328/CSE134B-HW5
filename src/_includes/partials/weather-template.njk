<template id="coastal-weather-template">
    <div class="weather-card">
        <p class="weather-status" data-weather-status role="status"></p>

        <p>
            <label for="weather-units">Units</label>
            <select id="weather-units" data-weather-units>
                <option value="fahrenheit">Fahrenheit</option>
                <option value="celsius">Celsius</option>
            </select>
        </p>

        <ul class="weather-details" data-weather-details hidden></ul>

        <button type="button" data-weather-retry hidden>Try again</button>
        <p class="weather-credit">
            Weather data from
            <a href="https://open-meteo.com/" rel="external">Open-Meteo</a>.
        </p>
    </div>
</template>
