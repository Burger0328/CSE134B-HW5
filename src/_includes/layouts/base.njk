<!doctype html>
<html lang="en">
    <head>
        {% include "partials/head.njk" %}
    </head>

    <body>
        <a class="skip-link" href="#main-content">Skip to main content</a>
        {% include "partials/header.njk" %}

        <main id="main-content"{% if not excludeFromSearch %} data-pagefind-body{% endif %}>
            {{ content | safe }}
        </main>

        {% include "partials/footer.njk" %}
        <script type="module" src="/js/theme-picker.js"></script>
        <script type="module" src="/js/reveal.js"></script>
        {% if pageScript %}<script type="module" src="{{ pageScript }}"></script>{% endif %}
    </body>
</html>
