<section class="page-hero"><p class="eyebrow">Selected engineering work</p><h1>Projects</h1><p class="intro">Each project is documented around the problem, my contribution, the engineering process, and the result.</p></section>
<ol class="project-grid">
{% for project in projects %}
    <li><article class="project-card">
        {% if project.image %}<img src="{{ project.image }}" alt="{{ project.alt }}" width="1200" height="800">{% else %}<div class="project-visual" aria-hidden="true"><span>{{ project.number }}</span></div>{% endif %}
        <p class="project-number">{{ project.number }}</p><h2>{{ project.title }}</h2>
        <p>{{ project.summary }}</p><p class="metric">{{ project.metric }}</p><p class="stack">{{ project.stack }}</p>
        <a href="/projects/{{ project.slug }}/">Read case study</a>
    </article></li>
{% endfor %}
</ol>
