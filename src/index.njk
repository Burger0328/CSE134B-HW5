<section>
    <div class="section-heading">
        <div><p class="eyebrow">Selected work</p><h2>Projects with measurable outcomes</h2></div>
        <a href="/projects/">View all projects</a>
    </div>
    <ol class="project-grid featured-grid">
        {% for project in projects %}
        <li>
            <article class="project-card">
                {% if project.image %}<img src="{{ project.image }}" alt="{{ project.alt }}" width="1200" height="800">{% else %}<div class="project-visual" aria-hidden="true"><span>{{ project.number }}</span></div>{% endif %}
                <p class="project-number">{{ project.number }} / {{ project.focus }}</p>
                <h3>{{ project.title }}</h3>
                <p>{{ project.summary }}</p>
                <p class="metric">{{ project.metric }}</p>
                <a href="/projects/{{ project.slug }}/">View case study</a>
            </article>
        </li>
        {% endfor %}
    </ol>
</section>

